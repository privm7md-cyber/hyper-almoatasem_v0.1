}

model SyncApplyReceipt {
  syncJobId            String    @id @map("sync_job_id")
  manifestId           String    @map("manifest_id")
  digest               String    @db.VarChar(255)
  actorId              String    @map("actor_id") @db.Uuid
  targetDatabase       String    @map("target_database") @db.VarChar(64)
  targetSystemIdentifier String  @map("target_system_identifier") @db.VarChar(64)
  actorPermission      String    @map("actor_permission") @db.VarChar(255)
  status               String    @map("status") @db.VarChar(16)
  appliedCount         Int       @map("applied_count")
  alreadyAppliedCount  Int       @map("already_applied_count")
  conflictedCount      Int       @map("conflicted_count")
  failedCount          Int       @map("failed_count")
  auditEventCount      Int       @map("audit_event_count")
  resultDigest         String?   @map("result_digest") @db.VarChar(255)
  note                 String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  @@index([manifestId], map: "idx_sync_apply_receipts_manifest")
  @@index([actorId], map: "idx_sync_apply_receipts_actor")
  @@map("sync_apply_receipts")
}
