// ============================ PHASE 6 — Admin Auth ==========================
// Auth foundation (20260923_admin_auth_foundation). DB-backed opaque sessions:
// only token HASHES live here; raw tokens exist transiently in the login flow
// and in the HttpOnly session cookie. createdIp is INET (raw-SQL writes, same
// posture as audit_logs); everything else is Prisma-mappable.

model AdminSession {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // SHA-256 hex of the 256-bit opaque token. Never the raw token.
  tokenHash  String               @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime?            @map("last_seen_at") @db.Timestamptz(6)
  createdIp  Unsupported("inet")? @map("created_ip")
  userAgent  String?              @map("user_agent") @db.VarChar(500)

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expiry")
  @@map("admin_sessions")
}

// One-time auth tokens (invitations + password resets). Plaintext exists only
// at creation time (delivered out-of-band); only the hash is stored. Atomic
// consumption: UPDATE ... WHERE used_at IS NULL AND expires_at > now().
model AdminAuthToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purpose   String    @db.VarChar(20) // INVITATION | PASSWORD_RESET (CHECK in SQL)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_tokens_user")
  @@map("admin_auth_tokens")
}

// Serverless-safe login rate-limit buckets. bucket_key is opaque to the DB
// (e.g. "login:ip:<ip>" / "login:acct:<user-id>"); rows are TTL-pruned by the
// application. Atomic bump: INSERT ... ON CONFLICT DO UPDATE (single statement).
model AdminAuthRateLimit {
  bucketKey   String   @map("bucket_key") @db.VarChar(128)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  attempts    Int      @default(1)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([bucketKey, windowStart])
  @@map("admin_auth_rate_limits")
}

// ============================ PHASE 7 — Customer Auth =========================
// Auth foundation (20261006_customer_auth). DB-backed opaque customer
// sessions: only token HASHES live here; raw tokens exist transiently in the
// login/register flow and in the HttpOnly session cookie. createdIp is INET
// (raw-SQL writes, same posture as admin_sessions); everything else is
// Prisma-mappable. Rate-limit buckets live in their own table — admin and
// customer authentication never share accounting.

model CustomerSession {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String               @map("customer_id") @db.Uuid
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // SHA-256 hex of the 256-bit opaque token. Never the raw token.
  tokenHash  String               @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime?            @map("last_seen_at") @db.Timestamptz(6)
  createdIp  Unsupported("inet")? @map("created_ip")
  userAgent  String?              @map("user_agent") @db.VarChar(500)

  @@index([customerId], map: "idx_customer_sessions_customer")
  @@index([expiresAt], map: "idx_customer_sessions_expiry")
  @@map("customer_sessions")
}

// Serverless-safe customer login rate-limit buckets. bucket_key is opaque to
// the DB (e.g. "login:cust-ip:<ip>" / "login:cust-acct:<phone>"); rows are
// TTL-pruned by the application. Atomic bump: INSERT ... ON CONFLICT DO
// UPDATE (single statement).
model CustomerAuthRateLimit {
  bucketKey   String   @map("bucket_key") @db.VarChar(128)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  attempts    Int      @default(1)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([bucketKey, windowStart])
  @@map("customer_auth_rate_limits")
}

// ============================ BG-GUEST-ORDER ================================
// Per-order guest access credential: only token HASHES live here (SHA-256 hex
// of the 256-bit opaque token returned once at issuance). One row per order;
// fixed expiry (no sliding); revocation by flag (rows are history, never
// deleted by the app). Raw-SQL reads/writes (credential + expiry gating stay
// in SQL, same posture as customer_sessions).
model GuestOrderCredential {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // SHA-256 hex of the 256-bit opaque token. Never the raw token.
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idx_guest_order_credentials_expiry")
  @@map("guest_order_credentials")
}

// Serverless-safe guest order rate-limit buckets. bucket_key is opaque to
// the DB (e.g. "guest-order:ip:<ip>"); rows are TTL-pruned by the
// application. Isolated table: guest accounting never shares admin/customer
// buckets. Atomic bump: INSERT ... ON CONFLICT DO UPDATE (single statement).
// Pre-established guest checkout recovery session (residual Phase-10 closure).
// Minted BEFORE order creation, bound to the guest cart, then bound to the
// created order inside the SAME create transaction. Only the SHA-256 hash is
// stored; the raw token lives solely in an HttpOnly cookie. It grants READ
// access to the bound order when the one-time 201 credential was lost, and is
// never a substitute for the 90-day per-order credential (24h fixed TTL, no
// sliding, revocation by flag). No customer row, no PII.
model GuestCheckoutSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  cartId    String    @map("cart_id") @db.Uuid
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderId   String?   @map("order_id") @db.Uuid
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([cartId], map: "idx_guest_checkout_cart")
  @@index([orderId], map: "idx_guest_checkout_order")
  @@index([expiresAt], map: "idx_guest_checkout_expiry")
  @@map("guest_checkout_sessions")
}

