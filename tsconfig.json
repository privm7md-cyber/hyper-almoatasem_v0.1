{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    // BA-H1: strict null/function checking enabled (2026-10-03). The 11
    // strict errors were fixed at their root (Zod PATCH schemas tightened to
    // match service contracts; dead-defensive null checks; explicit Prisma
    // data assignments) — no `any`, no `!`, no ts-ignore/ts-expect-error.
    // Deferred (documented roadmap, not silent): noUncheckedIndexedAccess,
    // exactOptionalPropertyTypes.
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    ".next-p10t/types/**/*.ts",
    ".next-p10t/dev/types/**/*.ts",
    ".next-p10/types/**/*.ts",
    ".next-p10/dev/types/**/*.ts",
    ".next-p10prod/types/**/*.ts",
    ".next-p10prod/dev/types/**/*.ts",
    ".next-p10verify/types/**/*.ts",
    ".next-p10verify/dev/types/**/*.ts",
    ".next-closure/types/**/*.ts",
    ".next-closure/dev/types/**/*.ts",
    ".next-p13r/types/**/*.ts",
    ".next-p13r/dev/types/**/*.ts",
    ".next-p14gate2/types/**/*.ts",
    ".next-p14gate2/dev/types/**/*.ts",
    ".next-perf/types/**/*.ts",
    ".next-perf/dev/types/**/*.ts",
    ".next-preview-3132/types/**/*.ts",
    ".next-preview-3132/dev/types/**/*.ts",
    ".next-closure-verify/types/**/*.ts",
    ".next-closure-verify/dev/types/**/*.ts",
    ".next-third-verify/types/**/*.ts",
    ".next-third-verify/dev/types/**/*.ts",
    ".next-adm-final-preview-20261112/types/**/*.ts",
    ".next-adm-final-preview-20261112/dev/types/**/*.ts",
    ".next-adm-final-build-20261112/types/**/*.ts",
    ".next-adm-final-build-20261112/dev/types/**/*.ts",
    ".next-p1208/types/**/*.ts",
    ".next-p1208/dev/types/**/*.ts",
    ".next-h2-repo-verify/types/**/*.ts",
    ".next-h2-repo-verify/dev/types/**/*.ts",
    ".next-h2-readiness-verify/types/**/*.ts",
    ".next-h2-readiness-verify/dev/types/**/*.ts",
    ".next-final-closure-verify/types/**/*.ts",
    ".next-final-closure-verify/dev/types/**/*.ts",
    ".next-isolated-e2e/types/**/*.ts",
    ".next-isolated-e2e/dev/types/**/*.ts",
    ".next-v1-ops/types/**/*.ts",
    ".next-v1-ops/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "_recovery"
  ]
}
