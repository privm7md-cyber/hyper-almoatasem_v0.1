{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    // BA-H1: strict null/function checking enabled (2026-10-03). The 11
    // strict errors were fixed at their root (Zod PATCH schemas tightened to
    // match service contracts; dead-defensive null checks; explicit Prisma
    // data assignments) — no `any`, no `!`, no ts-ignore/ts-expect-error.
    // Deferred (documented roadmap, not silent): noUncheckedIndexedAccess,
    // exactOptionalPropertyTypes.
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
