%% FINAL ERD v1 — Hyper Al-Moatasem PRODUCTION GATE (no SQL built)
%% 37 tables across 9 domains + 1 VIEW (product_stock_status) + 1 SEQUENCE (order_number_seq).
%% Frozen: P1 catalog+inventory (8), P2 customer+cart+order (8), P4 promotions (7), P5 admin (8).
%% New v1: product_images (1), payments (2), delivery (3). AuthN/sessions: NOT FROZEN (deferred).
%% Render: paste into any Mermaid viewer (GitHub, mermaid.live, docs tools).

erDiagram
    CATEGORIES ||--o{ CATEGORIES : "parent_of (self, RESTRICT)"
    CATEGORIES ||--o{ PRODUCTS : "categorizes (RESTRICT)"
    BRANDS ||--o{ PRODUCTS : "owns (RESTRICT)"
    PRODUCTS ||--o{ PRODUCT_VARIANTS : "has (RESTRICT)"
    PRODUCTS ||--o{ PRODUCT_IMAGES : "galleried_by (CASCADE)"
    PRODUCT_VARIANTS ||--|| INVENTORY : "stocked_as (1:1, RESTRICT)"
    PRODUCT_VARIANTS ||--o{ PRODUCT_CODES : "identified_by (CASCADE)"
    PRODUCT_VARIANTS ||--o{ INVENTORY_MOVEMENTS : "audited_by (RESTRICT)"
    PRODUCT_VARIANTS ||--o{ PRODUCT_PRICE_HISTORY : "repriced_in (RESTRICT)"
    CUSTOMERS ||--o{ CUSTOMER_ADDRESSES : "owns (RESTRICT)"
    CUSTOMERS ||--o{ CARTS : "shops_with (RESTRICT, <=1 ACTIVE)"
    CUSTOMERS ||--o{ ORDERS : "places (RESTRICT)"
    CARTS ||--o{ CART_ITEMS : "contains (CASCADE)"
    PRODUCT_VARIANTS ||--o{ CART_ITEMS : "listed_in (RESTRICT)"
    CARTS ||--o{ ORDERS : "converts_to (SET NULL)"
    ORDERS ||--o{ ORDER_ITEMS : "has (RESTRICT)"
    PRODUCT_VARIANTS ||--o{ ORDER_ITEMS : "frozen_in (RESTRICT)"
    ORDERS ||--o{ ORDER_STATUS_HISTORY : "audited_by (RESTRICT)"
    ORDER_ITEMS ||--o{ ORDER_ITEM_REPLACEMENTS : "proposed_for (RESTRICT)"
    PRODUCT_VARIANTS ||--o{ ORDER_ITEM_REPLACEMENTS : "substitutes_with (RESTRICT)"
    ORDER_ITEMS ||--o{ ORDER_ITEMS : "materialized_as (RESTRICT)"
    ORDERS ||--o{ PAYMENTS : "settled_by (RESTRICT)"
    PAYMENTS ||--o{ PAYMENT_TRANSACTIONS : "ledgered_in (RESTRICT)"
    ORDERS ||--o{ DELIVERIES : "fulfilled_by (RESTRICT, UQ)"
    DELIVERY_ZONES ||--o{ DELIVERIES : "zoned_in (RESTRICT)"
    DELIVERY_DRIVERS ||--o{ DELIVERIES : "driven_by (RESTRICT)"
    PROMOTIONS ||--o{ PROMOTION_TARGETS : "defines (CASCADE)"
    PROMOTIONS ||--|| PROMOTION_RULES : "constrained_by (CASCADE, 1:1)"
    PROMOTIONS ||--o{ PROMOTION_BUY_GET_RULES : "parameterized_by (CASCADE)"
    PROMOTIONS ||--o{ COUPONS : "accessed_via (CASCADE)"
    PROMOTIONS ||--o{ ORDER_DISCOUNTS : "applied_as (RESTRICT)"
    COUPONS ||--o{ COUPON_USAGES : "redeemed_in (RESTRICT)"
    COUPONS ||--o{ ORDER_DISCOUNTS : "applied_as (RESTRICT)"
    ORDERS ||--o{ ORDER_DISCOUNTS : "records (RESTRICT)"
    ORDER_ITEMS ||--o{ ORDER_DISCOUNTS : "attributed_to (RESTRICT)"
    ORDER_DISCOUNTS ||--o{ ORDER_DISCOUNTS : "allocated_into (self, RESTRICT)"
    CUSTOMERS ||--o{ COUPON_USAGES : "consumes (RESTRICT)"
    ORDERS ||--|| COUPON_USAGES : "evidences (RESTRICT, UQ)"
    PRODUCT_VARIANTS ||--o{ PROMOTION_BUY_GET_RULES : "frees (RESTRICT)"
    USERS ||--o{ USER_ROLES : "holds (RESTRICT)"
    ROLES ||--o{ USER_ROLES : "granted_to (RESTRICT)"
    ROLES ||--o{ ROLE_PERMISSIONS : "grants (RESTRICT)"
    PERMISSIONS ||--o{ ROLE_PERMISSIONS : "granted_as (RESTRICT)"
    USERS ||--o{ AUDIT_LOGS : "acted_by (RESTRICT, NULL=system)"
    USERS ||--o{ NOTIFICATIONS : "inbox_of (CASCADE)"

    CATEGORIES {
        uuid id PK
        varchar name
        varchar slug "UQ per-table"
        text description "nullable"
        varchar image "nullable cover"
        uuid parent_id "FK self NULL RESTRICT"
        boolean is_active
        int sort_order
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    BRANDS {
        uuid id PK
        varchar name
        varchar slug "UQ per-table"
        varchar logo "nullable"
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    PRODUCTS {
        uuid id PK
        varchar name
        varchar slug "UQ per-table"
        text description "nullable"
        uuid category_id "FK NOT NULL RESTRICT"
        uuid brand_id "FK nullable RESTRICT"
        varchar product_type "PIECE WEIGHT"
        varchar unit "PIECE KG GRAM LITER ML"
        int sale_step_grams "WEIGHT>0 PIECE=NULL"
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    PRODUCT_VARIANTS {
        uuid id PK
        uuid product_id "FK RESTRICT"
        varchar name "UQ per product"
        numeric size_value "nullable >0"
        varchar size_unit "nullable"
        numeric price "10,2 source of truth"
        numeric compare_at_price "nullable >=price"
        numeric cost_price "nullable"
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    PRODUCT_IMAGES {
        uuid id PK
        uuid product_id "FK CASCADE gallery"
        varchar url "500"
        varchar alt_text "nullable 200"
        int sort_order ">=0"
        boolean is_primary "partial UQ per product"
        timestamptz created_at
    }
    PRODUCT_CODES {
        uuid id PK
        uuid product_variant_id "FK CASCADE"
        varchar code "UQ global, keeps zeros"
        varchar type "BARCODE INTERNAL_CODE"
        boolean is_primary "one per variant"
        timestamptz created_at
        timestamptz updated_at
    }
    INVENTORY {
        uuid id PK
        uuid product_variant_id "FK UQ 1:1 RESTRICT"
        numeric quantity "12,3"
        numeric reserved_quantity "12,3"
        numeric available_quantity "GENERATED qty-reserved"
        numeric low_stock_threshold "nullable"
        timestamptz updated_at
    }
    INVENTORY_MOVEMENTS {
        uuid id PK "append-only"
        uuid product_variant_id "FK RESTRICT"
        varchar movement_type "7 types"
        numeric quantity "signed !=0"
        numeric previous_quantity
        numeric new_quantity "=prev+qty"
        varchar reference_type "nullable"
        varchar reference_id "nullable"
        text reason "nullable"
        uuid created_by "nullable"
        timestamptz created_at
    }
    PRODUCT_PRICE_HISTORY {
        uuid id PK "append-only"
        uuid product_variant_id "FK RESTRICT"
        numeric old_price "10,2"
        numeric new_price "10,2 !=old"
        uuid changed_by "nullable"
        text reason "nullable"
        timestamptz created_at
    }
    CUSTOMERS {
        uuid id PK
        varchar first_name
        varchar last_name "nullable"
        varchar phone "UQ normalized identity"
        varchar email "nullable partial UQ"
        varchar password_hash "nullable"
        boolean is_registered
        boolean auto_accept_replacements
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    CUSTOMER_ADDRESSES {
        uuid id PK
        uuid customer_id "FK RESTRICT"
        varchar label "nullable"
        varchar city
        varchar area "nullable"
        varchar village "nullable"
        varchar street "nullable"
        varchar building_number "nullable"
        varchar landmark "nullable"
        varchar phone
        boolean is_default "partial UQ per customer"
        timestamptz created_at
        timestamptz updated_at
    }
    CARTS {
        uuid id PK
        uuid customer_id "FK nullable RESTRICT"
        varchar session_id "nullable guest token"
        varchar status "5 states"
        timestamptz expires_at "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    CART_ITEMS {
        uuid id PK
        uuid cart_id "FK CASCADE"
        uuid product_variant_id "FK RESTRICT"
        numeric quantity "12,3 counting unit"
        varchar unit_snapshot
        numeric unit_price_snapshot "nullable quote"
        timestamptz price_checked_at "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    ORDERS {
        uuid id PK
        varchar order_number "UQ HM-date-seq"
        uuid customer_id "FK RESTRICT"
        uuid cart_id "FK nullable SET NULL"
        varchar idempotency_key "nullable UQ"
        varchar status "7 states, NO payment_status"
        numeric subtotal_estimated "10,2"
        numeric discount_total "10,2 = checkout estimate"
        numeric delivery_fee "10,2"
        numeric total_estimated "10,2 CHECK-balanced"
        numeric subtotal_final "nullable"
        numeric total_final "nullable"
        varchar customer_name_snapshot
        varchar customer_phone_snapshot
        varchar delivery_city
        varchar delivery_phone
        text notes "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    ORDER_ITEMS {
        uuid id PK
        uuid order_id "FK RESTRICT"
        uuid product_variant_id "FK RESTRICT"
        varchar product_name_snapshot
        varchar variant_name_snapshot
        numeric unit_price "10,2 frozen"
        numeric requested_quantity "12,3"
        numeric actual_quantity "nullable"
        numeric estimated_total "10,2 CHECK"
        numeric final_total "nullable CHECK"
        numeric discount_amount "10,2 mirror"
        varchar item_status "6 states"
        timestamptz created_at
        timestamptz updated_at
    }
    ORDER_STATUS_HISTORY {
        uuid id PK "append-only"
        uuid order_id "FK RESTRICT"
        varchar old_status "nullable on creation"
        varchar new_status
        varchar actor_type "SYSTEM CUSTOMER STAFF"
        uuid actor_id "nullable iff SYSTEM"
        text note "nullable"
        timestamptz created_at
    }
    ORDER_ITEM_REPLACEMENTS {
        uuid id PK
        uuid order_item_id "FK original RESTRICT"
        uuid replacement_variant_id "FK RESTRICT"
        numeric replacement_quantity "12,3"
        numeric replacement_unit_price "10,2"
        numeric price_difference "signed"
        varchar status "4 states"
        uuid replacement_order_item_id "nullable"
        timestamptz created_at
    }
    PAYMENTS {
        uuid id PK
        uuid order_id "FK RESTRICT, many attempts ok"
        varchar method "CASH_ON_DELIVERY CARD_ONLINE WALLET"
        numeric amount "10,2 agreed collectible"
        varchar currency "default EGP"
        varchar status "8 states"
        varchar provider_ref "nullable partial UQ"
        timestamptz created_at
        timestamptz updated_at
    }
    PAYMENT_TRANSACTIONS {
        uuid id PK "append-only"
        uuid payment_id "FK RESTRICT"
        varchar type "PAYMENT AUTHORIZATION CAPTURE REFUND VOID ADJUSTMENT"
        numeric amount "signed !=0"
        numeric previous_paid
        numeric new_paid "=prev+amount"
        text reason "nullable"
        uuid created_by "nullable"
        timestamptz created_at
    }
    DELIVERY_ZONES {
        uuid id PK
        varchar name "UQ"
        numeric delivery_fee "10,2"
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }
    DELIVERY_DRIVERS {
        uuid id PK
        varchar name
        varchar phone "UQ digits"
        varchar vehicle "nullable free text"
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    DELIVERIES {
        uuid id PK
        uuid order_id "FK RESTRICT UQ 1 per order"
        uuid zone_id "FK nullable RESTRICT"
        uuid driver_id "FK nullable RESTRICT"
        varchar status "6 states"
        timestamptz scheduled_at "nullable"
        timestamptz delivered_at "nullable"
        text failure_reason "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    PROMOTIONS {
        uuid id PK
        varchar name
        varchar type "4 types"
        varchar scope "LINE ORDER"
        varchar status "DRAFT ACTIVE DISABLED"
        timestamptz start_at "nullable"
        timestamptz end_at "nullable"
        numeric discount_percent "nullable gated"
        numeric discount_amount "nullable gated"
        numeric fixed_price "nullable gated"
        int priority
        boolean is_stackable
        int usage_limit "nullable"
        int used_count
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    PROMOTION_TARGETS {
        uuid id PK
        uuid promotion_id "FK CASCADE"
        varchar target_type "VARIANT PRODUCT BRAND CATEGORY"
        uuid target_id "NO FK"
        timestamptz created_at
    }
    PROMOTION_RULES {
        uuid id PK
        uuid promotion_id "FK CASCADE UQ 1:1"
        numeric minimum_quantity "nullable"
        numeric maximum_discount "nullable cap"
        timestamptz created_at
    }
    PROMOTION_BUY_GET_RULES {
        uuid id PK
        uuid promotion_id "FK CASCADE UQ 1:1"
        numeric buy_quantity "12,3"
        numeric get_quantity "12,3"
        numeric discount_percent "100=free"
        uuid free_variant_id "nullable =same RESTRICT"
        timestamptz created_at
    }
    COUPONS {
        uuid id PK
        uuid promotion_id "FK CASCADE NOT NULL"
        varchar code "UQ normalized"
        int usage_limit "nullable"
        int used_count
        int per_customer_limit "nullable"
        numeric minimum_order_amount "nullable"
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    COUPON_USAGES {
        uuid id PK "append-only"
        uuid coupon_id "FK RESTRICT"
        uuid customer_id "FK RESTRICT"
        uuid order_id "FK RESTRICT UQ 1 coupon"
        numeric estimated_discount_amount
        numeric final_discount_amount "nullable set once"
        timestamptz created_at
    }
    ORDER_DISCOUNTS {
        uuid id PK "append-only"
        uuid order_id "FK RESTRICT"
        uuid order_item_id "nullable RESTRICT"
        uuid promotion_id "FK NOT NULL RESTRICT"
        uuid coupon_id "nullable RESTRICT"
        varchar kind "LINE ORDER COUPON ALLOCATION"
        numeric discount_estimated "10,2"
        numeric discount_final "nullable set once"
        uuid parent_discount_id "nullable self RESTRICT"
        timestamptz created_at
    }
    USERS {
        uuid id PK
        varchar name
        varchar email "UQ lowercase login id"
        varchar phone "nullable partial UQ"
        boolean is_active
        timestamptz last_login_at "nullable"
        uuid created_by "nullable no FK"
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    ROLES {
        uuid id PK
        varchar name "UQ data rows"
        text description "nullable"
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at "nullable"
    }
    USER_ROLES {
        uuid id PK
        uuid user_id "FK RESTRICT"
        uuid role_id "FK RESTRICT"
        uuid assigned_by "nullable no FK"
        timestamptz created_at
    }
    PERMISSIONS {
        uuid id PK
        varchar key "UQ dotted action"
        text description "nullable"
        boolean is_active
        timestamptz created_at
    }
    ROLE_PERMISSIONS {
        uuid id PK
        uuid role_id "FK RESTRICT"
        uuid permission_id "FK RESTRICT"
        uuid granted_by "nullable no FK"
        timestamptz created_at
    }
    AUDIT_LOGS {
        uuid id PK "append-only never delete"
        uuid user_id "FK RESTRICT NULL=system"
        varchar actor_type "ADMIN SYSTEM"
        varchar action "dotted e.g. price.change"
        varchar entity_type "no FK"
        uuid entity_id "nullable"
        jsonb old_values "nullable sanitized"
        jsonb new_values "nullable sanitized"
        inet ip_address "nullable"
        varchar user_agent "nullable"
        timestamptz created_at
    }
    STORE_SETTINGS {
        uuid id PK
        varchar key "UQ e.g. store.name"
        text value_text
        varchar value_type "BOOLEAN INTEGER NUMERIC TEXT JSON"
        text description "nullable"
        uuid updated_by "nullable no FK"
        timestamptz created_at
        timestamptz updated_at
    }
    NOTIFICATIONS {
        uuid id PK
        uuid user_id "FK CASCADE inbox"
        varchar type "e.g. order.created"
        varchar title
        text message
        jsonb data "nullable ids only"
        timestamptz read_at "nullable"
        timestamptz created_at
    }
